<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>VFL.GeradorWebMToken</AssemblyName>
    <RootNamespace>VFL.GeradorWebMToken</RootNamespace>
    <ApplicationIcon>Assets\app-icon.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Authors>VFL</Authors>
    <Description>Converte vídeos com fundo sólido em tokens WebM VP9 transparentes para Foundry VTT.</Description>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="README.md" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="LICENSE.md" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
